# ====== API易 平台配置 ======
# 在 https://api.apiyi.com 获取 API Key

# 图片生成 (Gemini 图像模型)：APIYI_KEY
APIYI_KEY=your_apiyi_key_here

# LLM 智能提示词分析（房间识别 + 提示词增强）：LLM_APIYI_KEY
# 可以与 APIYI_KEY 相同，也可以使用独立账号
LLM_APIYI_KEY=your_llm_apiyi_key_here

# 是否启用 LLM 智能提示词（true / false）
USE_LLM_PROMPT=true
# 视觉分析和图片生成的服务端总时限（秒），必须低于前端/Nginx 超时
VISION_ANALYSIS_TIMEOUT_SECONDS=40
IMAGE_GENERATION_TIMEOUT_SECONDS=180
# 单次上游读取时限；超时后切换备用模型/供应商
IMAGE_PROVIDER_READ_TIMEOUT_SECONDS=60

# ====== Segmind SAM3 配置 ======
# 在 https://www.segmind.com 获取 API Key（用于家具/区域分割）
SEGMIND_API_KEY=your_segmind_api_key_here

# ====== 服务配置 ======
SERVER_PORT=8000
FRONTEND_URL=http://localhost:5173

# 后端外部访问地址（用于拼接 output 图片 URL）
BASE_URL=http://localhost:8000

# ====== 存储配置 ======
INPUT_DIR=./input
OUTPUT_DIR=./output
MAX_FILE_SIZE=10485760

# ====== 免费 Demo 登录与额度 ======
# 每个新注册账号可发起的生图次数
FREE_GENERATION_LIMIT=3
# 全站累计可发起的生图次数；提高此值并重启后端即可继续开放体验
GLOBAL_GENERATION_LIMIT=60
# 登录保持天数
AUTH_SESSION_DAYS=30
# 可选：SQLite 数据库位置（默认 backend/data/roommate.db）
# AUTH_DB_PATH=/var/lib/roommate/roommate.db
